# ==============================================================================
# PULSEENGINE - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# DO NOT COMMIT REAL API KEYS, PASSWORDS, OR SECRETS TO VERSION CONTROL (GIT/GITHUB).
# Copy this file to '.env' and populate with your own project-specific credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & ORM (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string with connection pooling enabled for high-throughput telemetry.
# Get yours from https://neon.tech
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/pulseengine?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION DOMAIN & SECURITY
# ------------------------------------------------------------------------------
# Application root URL for OAuth redirects, webhooks, and client callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cryptographic HMAC-SHA256 secret for signing stateless session JWT tokens.
# Generate via: openssl rand -base64 32
JWT_SECRET="generate_a_random_secure_32_character_jwt_secret_key_here"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (SSO Sign-in)
# ------------------------------------------------------------------------------
# Credentials from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. UPSTASH SERVERLESS REDIS (High-Throughput Ingestion Queue & Rate Limiter)
# ------------------------------------------------------------------------------
# Serverless Redis REST endpoint for buffering incoming logs and sliding-window rate limits.
# Get yours from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL="https://sample-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI 3.8 FLASH AI (Autonomous SRE Copilot)
# ------------------------------------------------------------------------------
# API Key powering autonomous root-cause analysis (RCA) and 1-click CLI remediation.
# Get yours from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 6. POLAR.SH SAAS BILLING & SUBSCRIPTIONS
# ------------------------------------------------------------------------------
# Polar checkout access token and product ID for Pro plan ($49/mo) upgrade lifecycle.
# Get yours from https://polar.sh
POLAR_ACCESS_TOKEN="polar_at_your_access_token_here"
POLAR_PRO_PRODUCT_ID="your-polar-product-id-uuid"
POLAR_SERVER="sandbox" # Options: 'sandbox' for testing, 'production' for live payments

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL DELIVERY (Gmail SMTP via Nodemailer)
# ------------------------------------------------------------------------------
# Primary delivery service: 100% Free, zero custom domain required, sends to any recipient.
# For local dev / testing: use your Google Account + 16-character App Password.
# Note: For production, you can replace with a dedicated project email or AWS SES / Resend.
GMAIL_USER="your-project-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-google-app-password"

# ==============================================================================
# NOTE ON DISCORD & SLACK ALERT WEBHOOKS:
# In PulseEngine, Discord and Slack incident alert webhooks are configured
# per-tenant directly in the Dashboard under "Billing & Integrations".
# They are securely saved in Neon PostgreSQL and DO NOT belong in this .env file.
# ==============================================================================
